<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NewLife.Video.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="NewLife.Video.Studio.Views.StreamingView"
             x:DataType="vm:StreamingViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Margin="8">
        <!-- RTSP 拉流 -->
        <Border Grid.Row="0" Padding="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox PlaceholderText="RTSP 地址..."
                         Text="{Binding RtspUrl}" />
                <Button Grid.Column="1" Content="测试拉流"
                        Command="{Binding TestRtspPullCommand}" />
            </Grid>
        </Border>

        <!-- RTMP 推流 -->
        <Border Grid.Row="1" Padding="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox PlaceholderText="RTMP 地址..."
                             Text="{Binding RtmpUrl}" />
                    <Button Grid.Column="1" Content="测试推流"
                            Command="{Binding TestRtmpPushCommand}"
                            IsEnabled="{Binding IsConnected, Converter={StaticResource BoolNegationConverter}}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding IsConnected}">
                    <TextBlock Text="已连接" Foreground="Green" FontWeight="Bold" />
                    <Button Content="断开" Command="{Binding DisconnectCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 日志输出 -->
        <ScrollViewer Grid.Row="2" Background="#1E1E1E" Padding="8">
            <TextBlock Text="{Binding StatusText}"
                       FontFamily="Consolas" Foreground="#D4D4D4" />
        </ScrollViewer>

        <!-- 快速帮助 -->
        <Border Grid.Row="3" Padding="8"
                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
            <TextBlock Text="提示: 输入完整 RTSP 或 RTMP URL 后点击对应按钮测试连接。"
                       FontSize="12" Foreground="Gray" />
        </Border>
    </Grid>
</UserControl>
