<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NewLife.Video.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="NewLife.Video.Studio.Views.ConverterView"
             x:DataType="vm:ConverterViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- 文件选择 -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="输入文件:" VerticalAlignment="Center" />
                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" PlaceholderText="选择源视频文件..."
                             Text="{Binding InputPath}" />
                    <Button Grid.Column="1" Content="浏览..." Margin="4,0,0,0"
                            Command="{Binding BrowseInputCommand}" />
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="输出文件:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="自动生成..."
                         Text="{Binding OutputPath}" />
            </Grid>
        </Border>

        <!-- 转换参数 -->
        <Border Grid.Row="1" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="输出格式:" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding OutputFormats}"
                              SelectedItem="{Binding SelectedOutputFormat}"
                              Width="80" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="编码器:" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding EncoderOptions}"
                              SelectedItem="{Binding SelectedEncoder}"
                              Width="130" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="宽度:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding OutputWidth}" Width="60" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="高度:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding OutputHeight}" Width="60" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 进度条 -->
        <Border Grid.Row="2" Padding="8"
                IsVisible="{Binding IsConverting}">
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="20" />
        </Border>

        <!-- 日志/输出区域（预留） -->
        <ScrollViewer Grid.Row="3" Padding="8">
            <TextBlock Text="{Binding StatusText}" />
        </ScrollViewer>

        <!-- 操作按钮 -->
        <Border Grid.Row="4" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="开始转换"
                        Command="{Binding ConvertCommand}"
                        IsEnabled="{Binding IsConverting, Converter={StaticResource BoolNegationConverter}}" />
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
