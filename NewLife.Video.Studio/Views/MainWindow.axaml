<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NewLife.Video.Studio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="NewLife.Video.Studio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/avalonia-logo.ico"
        MinWidth="800" MinHeight="500">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <ItemsControl ItemsSource="{Binding NavItems}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                        <Border Background="Transparent"
                                Margin="4,2"
                                Padding="0"
                                CornerRadius="6">
                            <Button Content="{Binding Icon}"
                                    FontSize="22"
                                    Width="40" Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Command="{Binding $parent[ItemsControl].DataContext.NavigateCommand}"
                                    CommandParameter="{Binding .}"
                                    ToolTip.Tip="{Binding Title}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 分隔线 -->
        <Rectangle Grid.Column="1" Width="1"
                   Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- 右侧内容区 -->
        <Border Grid.Column="2" Padding="0">
            <ContentControl Content="{Binding CurrentView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</Window>
