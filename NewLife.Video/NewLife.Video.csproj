<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;netstandard2.0;net461;net8.0;net10.0</TargetFrameworks>
    <AssemblyTitle>视频编解码</AssemblyTitle>
    <Description>支持各种视频编解码、容器格式、帧处理、流媒体传输和IoT视频适配</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 新生命开发团队</Copyright>
    <VersionPrefix>1.2</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- net8+ 对齐 NewLife.Core 策略：启用 AOT/裁剪分析器；SDK 会将目标程序集标记为 IsTrimmable -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/iot</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.Video</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>视频;Video;H264;H265;MJPEG;RTSP;RTMP;ONVIF;Studio;AAC;fMP4;GIF;新生命团队;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>新增 NewLife.Video.Studio 桌面客户端应用；纯托管 GIF 编码器并移除 ImageSharp/SkiaSharp/LibVLCSharp 外部依赖；新增 fMP4 分段写入与盒子结构支持；ONVIF RecordingClient Profile G 边缘存储录像；播放器自动分辨率探测与 RTSP TCP 支持；PixelFormatConverter SIMD 加速与 BT.709 色彩空间；FFmpegSetup 自动下载与 VideoTranscoder 转码高级 API；引入 NewLife.Audio 统一 AAC 音频能力</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NewLife.Audio" Version="1.2.2026.1019-beta1253" />
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1019-beta1413" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
