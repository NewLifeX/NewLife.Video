<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;netstandard2.0;net461;net8.0;net10.0</TargetFrameworks>
    <AssemblyTitle>NewLife Video Library</AssemblyTitle>
    <Description>Video codecs, container formats, frame processing, streaming media and IoT video adaptation.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 新生命开发团队</Copyright>
    <VersionPrefix>1.3</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- net8+ 对齐 NewLife.Core 策略：启用 AOT/裁剪分析器；SDK 会将目标程序集标记为 IsTrimmable -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageDescription>Video codecs, container formats, frame processing, streaming media and IoT video adaptation. 视频编解码、容器格式、帧处理、流媒体传输与IoT视频适配。</PackageDescription>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/iot</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.Video</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>视频;Video;H264;H265;MJPEG;RTSP;RTMP;ONVIF;Studio;AAC;fMP4;GIF;新生命团队;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>运行时词表扩展到 11 种语言并新增带前缀日志，异常与运行期消息全量本地化；库侧启用 AOT 兼容（net8.0/net10.0 分析器 0 告警）并新增 AotSmoke 冒烟工程；新增 Android/iOS 移动端冒烟与 riscv64/s390x 指令集校验；单元测试覆盖 win-x64/linux-x64/linux-arm64/loongarch64 与 net8.0/net10.0；修复 Mp4Writer 样本偏移与帧格式，产出的 MP4 可被标准工具解析；修复 AMF0 对象结束标记未写入流；依赖升级到 NewLife.Core 12</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NewLife.Audio" Version="1.2.2026.1022-beta0125" />
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
